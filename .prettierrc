{
    "arrowParens": "always",
    "bracketSpacing": true,

    "jsxBracketSameLine": false,
    "jsxSingleQuote": false,
    "singleQuote": false,

    "quoteProps": "as-needed",

    "printWidth": 120,
    "tabWidth": 4,

    "plugins": ["@trivago/prettier-plugin-sort-imports"],
    "importOrder": [
        "^react",
        "<THIRD_PARTY_MODULES>",

        "^(@/app)(.*)$",
        "^(@/pages)(.*)$",
        "^(@/widgets)(.*)$",
        "^(@/feature)(.*)$",
        "^(@/entities)(.*)$",
        "^(@/shared)(.*)$",

        "^(.*)/(.*)$"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": false
}
